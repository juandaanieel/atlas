{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schema/atlas-story.schema.json",
  "title": "Atlas package reading guide",
  "description": "A snapshot-bound, declarative guide that drives Atlas Explorer state.",
  "type": "object",
  "required": ["story_version", "snapshot_id", "title", "summary", "chapters"],
  "properties": {
    "story_version": { "const": 2 },
    "snapshot_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/chapter" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "chapter": {
      "type": "object",
      "required": ["id", "kind", "title", "body", "view", "evidence"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "kind": { "enum": ["chapter", "pipeline", "signal"] },
        "title": { "type": "string", "minLength": 1 },
        "body": { "type": "string", "minLength": 1 },
        "view": { "$ref": "#/$defs/view" },
        "evidence": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "signal" } } },
          "then": { "properties": { "view": { "required": ["signal"] } } },
          "else": { "properties": { "view": { "not": { "required": ["signal"] } } } }
        },
        {
          "if": { "properties": { "kind": { "const": "pipeline" } } },
          "then": { "properties": { "view": { "required": ["pipeline_root"] } } }
        }
      ],
      "additionalProperties": false
    },
    "view": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "scope": { "type": "string" },
        "level": { "enum": ["package", "module", "function"] },
        "unfold": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "camera": { "enum": ["axonometric", "plan", "elevation"] },
        "signal": { "enum": ["dead", "clones", "load_bearing", "import_cycles"] },
        "pipeline_root": { "type": "string", "minLength": 1 },
        "context": { "enum": ["0", "1", "2", "all"] },
        "structure": { "type": "boolean" },
        "cross_file": { "type": "boolean" },
        "selection": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "object": { "type": "string", "minLength": 1 },
        "trace_start": { "type": "string", "minLength": 1 },
        "trace_end": { "type": "string", "minLength": 1 }
      },
      "dependentRequired": {
        "trace_start": ["trace_end"],
        "trace_end": ["trace_start"]
      },
      "allOf": [
        {
          "if": {
            "properties": { "cross_file": { "const": true } },
            "required": ["cross_file"]
          },
          "then": {
            "properties": { "structure": { "const": true } },
            "required": ["structure"]
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
